# Copy to .env and replace the placeholder values. .env is git-ignored.

# Local Jenkins administrator (created on first start by Configuration as Code)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Shared token that lets the Jenkins pipeline submit evidence to the AI service
AI_INGEST_TOKEN=change-me-too

# AI provider: "mock" (deterministic, offline, default) or "llm" (OpenAI-compatible API)
AI_PROVIDER=mock

# Only used when AI_PROVIDER=llm. Real LLM calls may cost money.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# true = if the LLM fails or its answer is rejected, use the rule-based analysis and say so
AI_FALLBACK_TO_MOCK=false
